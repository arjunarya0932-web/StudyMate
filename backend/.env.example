# StudyMate Production Configuration Template
# =============================================
# Copy this file to .env and fill in values before deployment
# NEVER commit .env files with real secrets to version control

# ============================================================
# BACKEND CONFIGURATION - REQUIRED
# ============================================================

# JWT Secret Key (required for authentication)
# Generate securely for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 32 characters recommended
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-characters

# Database URL
# For production, use PostgreSQL or MySQL
# Format: postgresql://user:password@host:port/database
# SQLite example (development only): sqlite:///./studymate.db
DATABASE_URL=postgresql://user:password@localhost:5432/studymate_db

# ============================================================
# OPTIONAL: CORS CONFIGURATION
# ============================================================

# Allowed CORS origins (comma-separated, no spaces)
# Add your production domain(s) for deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================================
# OPTIONAL: DEVELOPMENT OVERRIDES
# ============================================================

# Debug mode (true for development, false for production)
DEBUG=true